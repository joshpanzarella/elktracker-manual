{
  "name": "elktracker-manual",
  "version": "0.1.0",
  "private": true,
  "description": "Animated visual manual for ElkTracker: the tracker UI recreated in Remotion and driven by song + timeline data.",
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "studio": "remotion studio",
